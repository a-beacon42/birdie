# Azure Cosmos DB
COSMOS_ENDPOINT=https://<your-account>.documents.azure.com:443/
COSMOS_KEY=<your-cosmos-key>  # Leave empty to use managed identity (DefaultAzureCredential)
COSMOS_DATABASE=birdie

# eBird API
EBIRD_API_KEY=<your-ebird-api-key>

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-openai-api-key>  # Leave empty to use managed identity
AZURE_OPENAI_DEPLOYMENT_NAME=<your-deployment>
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# API authentication (required for chat endpoint)
API_KEY=<generate-a-random-secret>

# User accounts
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
EMAIL_ENCRYPTION_KEY=<64-char-hex-string>
# USER_TOKEN_LIFETIME=86400       # 24 hours (default)
# BCRYPT_ROUNDS=12                # default; lower (e.g. 4) for tests
# MAX_FAILED_LOGINS=5             # lock account after N failures
# LOCKOUT_DURATION_MINUTES=15     # lockout cooldown

# Rate limiting (slowapi format: "count/period")
CHAT_RATE_LIMIT=10/minute

# CORS — comma-separated origins (include your Container Apps URL for mobile clients)
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:8000

# CORS (comma-separated origins allowed)
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006