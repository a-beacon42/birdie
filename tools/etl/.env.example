# Cosmos DB
COSMOS_ENDPOINT=https://<your-account>.documents.azure.com:443/
COSMOS_KEY=<your-cosmos-key>
COSMOS_DATABASE=birdie

# eBird API
EBIRD_API_KEY=<your-ebird-api-key>

# iNaturalist Open Data (S3 bucket, public — no credentials needed)
# Override only if using a local mirror:
# INAT_S3_BUCKET=inaturalist-open-data

# Xeno-canto (no key needed, public API)
