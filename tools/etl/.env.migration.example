# Source Cosmos DB (old account — e.g. WUS2)
SRC_COSMOS_ENDPOINT=https://<old-account>.documents.azure.com:443/
SRC_COSMOS_KEY=<old-account-primary-key>
SRC_COSMOS_DATABASE=birdie

# Destination Cosmos DB (new account — e.g. EUS2)
DST_COSMOS_ENDPOINT=https://<new-account>.documents.azure.com:443/
DST_COSMOS_KEY=<new-account-primary-key>
DST_COSMOS_DATABASE=birdie
