{
    "extends": [
        "expo",
        "prettier"
    ],
    "rules": {
        "import/order": "off",
        "@typescript-eslint/no-unused-vars": [
            "warn",
            {
                "argsIgnorePattern": "^_"
            }
        ]
    },
    "ignorePatterns": [
        "node_modules/",
        "tools/",
        "backend/",
        ".expo/"
    ]
}